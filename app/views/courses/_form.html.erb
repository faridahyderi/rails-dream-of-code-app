<%= form_with(model: @course, local: true) do |form| %>
  <% if @course.errors.any? %>
    <div style="color: red">
      <h2><%= pluralize(@course.errors.count, "error") %> prohibited this course from being saved:</h2>
      <ul>
        <% @course.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :coding_class_id, "Coding Class", style: "display: block" %>
    <%= form.collection_select :coding_class_id, CodingClass.all, :id, :title, prompt: "Select a class" %>
    <p style="font-size: small; color: gray;">
      Each class also has a description: <%= CodingClass.first&.description %>
    </p>
  </div>

  <div>
    <%= form.label :trimester_id, "Trimester", style: "display: block" %>
    <%= form.collection_select :trimester_id, Trimester.all,:id, :display_name, prompt: "Select a trimester" %>
    <p style="font-size: small; color: gray;">
      Deadline and details come from its description.
    </p>
  </div>

  <div>
    <%= form.label :max_enrollment, style: "display: block" %>
    <%= form.number_field :max_enrollment %>
  </div>

  <div>
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
